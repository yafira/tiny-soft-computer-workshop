---
// add photos to public/gallery/ and list them in src/data/gallery.json:
// { "src": "/gallery/name.jpg", "alt": "what it looks like", "by": "first name (optional)" }
import items from '../data/gallery.json';
import { p } from '../lib/url.js';
---
{items.length > 0 && (
  <section class="block gallery" aria-label="tiny soft computers made by workshop participants">
    <span class="tag">made at softer</span>
    <h2>what everyone made</h2>
    <p>
      same kit, 16 different ideas of what a tiny soft computer could be.
    </p>

    <div class="gallery-wrap">
      <ul class="gallery-track" tabindex="0" aria-label="photo carousel, scroll sideways">
        {items.map((item) => (
          <li class="gallery-item">
            <img src={p(item.src)} alt={item.alt} loading="lazy" decoding="async" />
            {item.by && <span class="gallery-by">{item.by}</span>}
          </li>
        ))}
      </ul>
      <button class="gallery-btn prev" type="button" aria-label="previous photo">←</button>
      <button class="gallery-btn next" type="button" aria-label="next photo">→</button>
    </div>
  </section>
)}

<style>
  .gallery p {
    text-wrap: balance;
  }
  .gallery-wrap {
    position: relative;
    margin-top: 1.2rem;
  }
  .gallery-track {
    list-style: none;
    margin: 0;
    padding: 0 0 0.6rem;
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .gallery-item {
    flex: 0 0 min(78%, 20rem);
    scroll-snap-align: start;
    margin: 0;
  }
  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-dim);
  }
  .gallery-by {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .gallery-btn {
    position: absolute;
    top: calc(50% - 1.5rem);
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .gallery-btn:hover {
    background: var(--mustard-dim);
  }
  .gallery-btn.prev { left: -0.6rem; }
  .gallery-btn.next { right: -0.6rem; }
  @media (max-width: 40rem) {
    .gallery-btn { display: none; }
  }
</style>

<script>
  document.querySelectorAll('.gallery-wrap').forEach((wrap) => {
    const track = wrap.querySelector('.gallery-track');
    const step = () => track.clientWidth * 0.8;
    wrap.querySelector('.prev')?.addEventListener('click', () => track.scrollBy({ left: -step() }));
    wrap.querySelector('.next')?.addEventListener('click', () => track.scrollBy({ left: step() }));
  });
</script>
