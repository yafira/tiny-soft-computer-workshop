---
import { p } from '../lib/url.js';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
---
<Layout
  title="tiny soft computer — a workshop by alannabean x electrocute"
  description="A 3-hour hands-on workshop on making and teaching soft electronics. Build your own tiny soft computer."
  active="home"
>

  <section class="hero">
    <p class="kicker">alannabean × electrocute — a tiny (and soft) workshop</p>
    <h1>a computer doesn't have to look or behave the way you expect.</h1>
    <p class="lede">
      a 3-hour hands-on workshop on making, and teaching, soft electronics.
      you'll build a small, tactile object made from fabric, wiring, and
      simple electronics. no prior experience with code, hardware, or
      soldering required.
    </p>

    <div class="screen">
      <div class="screen-text" id="screen-text">tiny soft computer</div>
    </div>

    <p>
      <a class="btn" href={p('/workshop')}>attending the workshop →</a>
      &nbsp;
      <a class="btn" href={p('/educators')}>setting up as an educator →</a>
    </p>
  </section>

  <div class="divider"><img class="divider-icon" src={p('/images/blossom-divider.png')} alt=""></div>

  <section class="block">
    <span class="tag">the idea</span>
    <h2>press a button. get something soft.</h2>
    <p>
      each kit is built around a single button and a small e-ink screen.
      press it, and a small kind reminder appears, the kind of thing
      people often need to hear and rarely say to themselves. the code
      behind it is intentionally simple, easy to read, easy to tweak,
      easy to make your own.
    </p>
    <p>
      the point isn't the electronics. it's the question underneath them:
      what else could a computer be, if it didn't have to look like one?
    </p>
  </section>

  <section class="block">
    <span class="tag">what you'll leave with</span>
    <h2>a working object, and a way to teach it</h2>
    <p>
      you'll build your own tiny soft computer from scratch, and you'll
      also learn how the kit itself was designed to be taught: how it's
      sequenced, what makes it approachable for someone who has never
      touched electronics before, and how to pass that on.
    </p>
  </section>

  <section class="block">
    <span class="tag">for this site</span>
    <h2>documentation, as we build it</h2>
    <p>
      this site is a working record of the process, kept in the open so
      it can be handed to attendees and educators after the workshop.
      the <a href={p('/educators')}>educator setup guide</a> and <a href={p('/code')}>code</a> reflect real testing, including the mistakes and fixes along the way.
    </p>
  </section>

  <Gallery />

  <div class="divider"><img class="divider-icon" src={p('/images/blossom-divider.png')} alt=""></div>

  <section class="block">
    <h2>quick links</h2>
    <ul class="plain">
      <li><a href={p('/workshop')}>workshop day</a> — what attendees actually do, hardware, software, fabrication</li>
      <li><a href={p('/fabrication')}>fabrication</a> — materials and starting points for your enclosure</li>
      <li><a href={p('/faq')}>faq</a> — safety, power, batteries, and what to do if something stops working</li>
      <li><a href={p('/educators')}>for educators</a> — full setup guide, prep work, troubleshooting</li>
      <li><a href={p('/code')}>the code</a> — the full working code.py, ready to copy or tweak</li>
      <li><a href={p('/resources')}>resources</a> — bill of materials, pricing, and alternatives</li>
      <li><a href={p('/zine/softer-zine-web.pdf')} target="_blank" rel="noopener">the zine</a> — a short read on the workshop and the ideas behind it</li>
      <li><a href={p('/gallery')}>gallery</a> — tiny soft computers made by people around the world</li>
      <li><a href={p('/about')}>about</a> — pedagogy, references, and why the display waits 180 seconds</li>
    </ul>
  </section>

  <script src={p('/script.js')} is:inline></script>

</Layout>
