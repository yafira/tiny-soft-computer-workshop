---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const codeContent = fs.readFileSync(
  path.resolve('./public/tiny_soft_computer_code.py'),
  'utf-8'
);

const oledCodeContent = fs.readFileSync(
  path.resolve('./public/tiny_soft_computer_oled_code.py'),
  'utf-8'
);
---
<Layout
  title="the code — tiny soft computer"
  description="The full working code.py for the tiny soft computer, ready to copy and tweak."
  active="code"
>

  <section class="hero" style="padding-top: 2.5rem;">
    <p class="kicker">code.py</p>
    <h1>press a button, get something soft</h1>
    <p class="lede">
      this is the full working code, unedited. copy it onto your
      CIRCUITPY drive as <code>code.py</code>. the <code>content</code>
      list near the top, messages and small ASCII art, is the part
      you're meant to change, everything else can stay as it is.
    </p>
  </section>

  <section class="block">
    <h2>what to edit</h2>
    <p>
      look for the block marked <code>MESSAGES + ASCII ART</code>. it's a
      plain list, short phrases and a few small pieces of ASCII art (a
      face, a tiny sun). add your own, remove ones that don't feel right,
      reorder them, that's the whole interface. keep text short and
      ASCII art narrow, the screen is small.
    </p>
  </section>

  <section class="block">
    <h2>the full code</h2>
    <div class="code-block">
      <button class="copy-btn" id="copy-code-btn" type="button">copy</button>
      <pre><code id="code-content">{codeContent}</code></pre>
    </div>
    <p>
      <a class="btn" href="/tiny_soft_computer_code.py" download>download code.py</a>
    </p>
  </section>

  <section class="block">
    <h2>alternative: OLED version</h2>
    <p>
      if you're using a monochrome OLED instead of the eInk display (see
      <a href="/resources">resources</a> for why and how to swap), this
      is the working code for it. simpler than the eInk version, since
      OLED has no refresh-rate limit to design around.
    </p>
    <div class="code-block">
      <button class="copy-btn" id="copy-oled-code-btn" type="button">copy</button>
      <pre><code id="oled-code-content">{oledCodeContent}</code></pre>
    </div>
    <p>
      <a class="btn" href="/tiny_soft_computer_oled_code.py" download>download OLED code.py</a>
    </p>
  </section>

  <section class="block">
    <h2>libraries this needs</h2>
    <p>from the CircuitPython Library Bundle, matching your board's version:</p>

    <h3>for the eInk version (code.py above)</h3>
    <ul class="plain">
      <li><code>adafruit_il0373.mpy</code></li>
      <li><code>adafruit_display_text</code> (folder)</li>
    </ul>

    <h3>for the OLED version</h3>
    <ul class="plain">
      <li><code>adafruit_displayio_ssd1306.mpy</code></li>
      <li><code>adafruit_display_text</code> (folder), same one, shared by both versions</li>
    </ul>

    <p>full install steps are on the <a href="/educators">educator setup guide</a>.</p>
  </section>

  <script is:inline>
    function wireCopyButton(buttonId, codeId) {
      const copyBtn = document.getElementById(buttonId);
      const codeEl = document.getElementById(codeId);
      if (copyBtn && codeEl) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(codeEl.textContent);
            copyBtn.textContent = 'copied!';
          } catch (err) {
            copyBtn.textContent = 'couldn\'t copy';
          }
          setTimeout(() => {
            copyBtn.textContent = 'copy';
          }, 2000);
        });
      }
    }
    wireCopyButton('copy-code-btn', 'code-content');
    wireCopyButton('copy-oled-code-btn', 'oled-code-content');
  </script>

</Layout>